{
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/build_static.mjs",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "installCommand": "npm ci --omit=dev",
  "functions": {
    "api/backend.js": {
      "maxDuration": 30,
      "excludeFiles": "{validation/**,resultados*/**,modelos/**,shortforge/**,tests/**,docs/**,.env*,.vercel/**,**/__pycache__/**,**/*.mp4,**/*.zip}"
    }
  }
}
